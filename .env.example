# Biomni Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Required: set at least ONE provider key profile below.

# Anthropic (direct API)
ANTHROPIC_API_KEY=
# Optional custom Anthropic-compatible endpoint (default is api.anthropic.com)
# ANTHROPIC_BASE_URL=

# AZURE (shared endpoint/deployment fields)
ENDPOINT_URL=
DEPLOYMENT_NAME=

# Optional: Azure Anthropic API Key (for Claude via Azure AI Foundry)
AZURE_ANTHROPIC_API_KEY=

# Optional: Azure OpenAI API Key (for GPT via Azure OpenAI)
AZURE_OPENAI_API_KEY=

# OpenAI (direct API)
OPENAI_API_KEY=
# Optional custom OpenAI-compatible endpoint (default is api.openai.com)
# OPENAI_BASE_URL=

# Optional: AWS Bedrock Configuration (if using AWS Bedrock models)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=us-east-1

# Optional: Custom model serving configuration
# CUSTOM_MODEL_BASE_URL=http://localhost:8000/v1
# CUSTOM_MODEL_API_KEY=your_custom_api_key_here

# Optional: Biomni data path (defaults to ~/.biomni/data)
# BIOMNI_DATA_PATH=/path/to/your/data

# Optional: Additional user data folder shown in the chat portal dataset browser
# Docker compose mounts this host folder to /app/user-data (read-only) for user local datasets.
# App data/runs are bind-mounted by default so local repo paths are visible in container.
# Override these only if you need custom host locations:
# BIOMNI_APP_DATA_HOST_PATH=./data
# BIOMNI_RUNS_HOST_PATH=./runs
# Default host folder: /tmp/biomni_user_data
# To use a VM /mnt folder, set:
# BIOMNI_USER_DATA_HOST_PATH=/mnt

# Optional: Host port for Docker publishing (container always listens on 8000)
# Use this when VM port 8000 is already occupied (e.g., HOST_PORT=8080)
# HOST_PORT=8000

# Optional: Container user. Default is 0:0 (root) so the default bind mounts
# work without host-side permission setup. For security-hardened deployments,
# set this to the micromamba non-root user and pre-chown the bind-mounted
# host data/runs paths to that UID.
# BIOMNI_CONTAINER_USER=57439:57439

# Optional: Timeout settings
# BIOMNI_TIMEOUT_SECONDS=600

# Optional: Automatically switch to local-first mode if network/API calls fail
# BIOMNI_AUTO_NETWORK_LIMITED_MODE=true

# ---------------------------------------------------------------------------
# Authentication gateway and platform monitoring
# ---------------------------------------------------------------------------

# The app never authenticates anyone itself: an authentication gateway in front
# of it validates the caller and forwards their details as HTTP headers. Set
# this ONLY when such a gateway is in front AND it strips client-supplied copies
# of those headers - without it, anyone who can reach the app can claim to be
# anyone. It fails closed: while unset, every session is anonymous.
# BIOMNI_TRUST_AUTH_HEADERS=true

# Header names, if the gateway does not use the GRIP defaults below. Each is a
# comma-separated list, tried in order, and the defaults still apply after it.
#
# GRIP sends both fields as one comma-separated `key=value` list per header:
#   Ai-App-User-Context: email=...,given_name=...,family_name=...,sub=...
#   Ai-App-Workspace-Context: uuid=...
# BIOMNI_AUTH_USER_CONTEXT_HEADER=ai-app-user-context
# BIOMNI_AUTH_WORKSPACE_CONTEXT_HEADER=ai-app-workspace-context
#
# Single-value headers, for other gateways (oauth2-proxy, Envoy/ext_authz, ...).
# Used for any field the context headers above did not supply.
# BIOMNI_AUTH_USER_ID_HEADER=x-auth-request-user-id
# BIOMNI_AUTH_EMAIL_HEADER=x-auth-request-email
# BIOMNI_AUTH_WORKSPACE_HEADER=x-workspace-id

# With no gateway there is no stable identity, so preferences, run history and
# chat threads are not persisted at all. Declare the deployment single-user to
# keep one shared set of them - development and single-user deployments only,
# since everyone reaching the app then shares one history.
# BIOMNI_ALLOW_ANONYMOUS_PERSISTENCE=true

# GET /status reports `active: false` once nothing has run and nobody has
# touched the app for this long (default 14400 = 4 hours). Work in flight always
# reports active, however long it runs.
# BIOMNI_STATUS_INACTIVITY_SECONDS=14400
